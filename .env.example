# ---------------------------------------------------------------------------
# WatchGuard Study Portal configuration
# Copy to .env and set real values. Never commit the resulting file.
# ---------------------------------------------------------------------------

# GEMINI_API_KEY: Required only for optional Gemini AI tutor features.
# The portal is fully functional with this unset (offline Q&A mode).
GEMINI_API_KEY=""

# APP_URL: The URL where this portal is hosted.
APP_URL="http://localhost:3000"

# ENABLE_AI_FEATURES: Set to true to enable Gemini AI-powered features.
# Set to false to run the application in 100% offline local-fallback mode.
ENABLE_AI_FEATURES=false

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# ADMIN_BOOTSTRAP_USER: the preferred way to create the first administrator.
# The account registered with this username is granted the administrator role
# automatically. Every later administrator is promoted from the admin console.
ADMIN_BOOTSTRAP_USER=""

# ADMIN_PASSWORD: optional break-glass credential. It is needed at most once
# per administrator: entering it promotes the signed-in account, after which
# the account's own PIN is sufficient.
#
# The server REFUSES TO START if this is set to a known default (admin123,
# admin, password, changeme, watchguard) or is shorter than 12 characters.
# Leave it empty to disable break-glass access entirely.
ADMIN_PASSWORD=""

# TRUSTED_PROXY_HOPS: number of reverse proxies in front of this process.
# 0 (default) = no proxy, trust nothing. 1 = a single Pangolin/Traefik/nginx
# layer. This value decides which address rate limiting treats as the client,
# so an incorrect value either breaks brute-force protection or logs the
# proxy's address instead of the visitor's. Set it to match the deployment.
TRUSTED_PROXY_HOPS=0

# TRUSTED_PROXY_CIDR: alternative to the hop count — a comma-separated list of
# proxy addresses or CIDR ranges to trust. Takes precedence when set.
# TRUSTED_PROXY_CIDR="172.18.0.0/16"

# COOKIE_SECURE: whether session cookies carry the Secure flag.
# Defaults to true when NODE_ENV=production. Set it to false ONLY for a
# plain-HTTP LAN deployment — with it left on, browsers silently discard the
# session cookie over HTTP and sign-in appears to do nothing.
# COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Durable account/progress database directory. Compose mounts a named volume
# at /data. Keep this volume across upgrades or learners lose their progress.
DATA_DIR=./data
